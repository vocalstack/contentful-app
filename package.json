{
  "name": "@vocalstack/contentful",
  "version": "0.1.0",
  "private": true,
  "description": "VocalStack for Contentful: a Transcribe button on every entry with audio, its VocalStack calls in an App Function.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build && contentful-app-scripts build-functions --ci",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "upsert-actions": "contentful-app-scripts upsert-actions",
    "deploy": "npm run upload && npm run upsert-actions",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN",
    "upsert-actions-ci": "contentful-app-scripts upsert-actions --ci --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN",
    "e2e": "e2e/run.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vocalstack/contentful-app.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@contentful/app-sdk": "^4.74.0",
    "@contentful/f36-components": "^6.27.1",
    "@contentful/f36-icons": "^6.27.1",
    "@contentful/f36-tokens": "^6.3.1",
    "@contentful/react-apps-toolkit": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@contentful/app-scripts": "^4.1.14",
    "@contentful/node-apps-toolkit": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
